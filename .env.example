# Optional local path overrides. Keep secrets in .env, never in this file.
BAGM_ROOT=/workspace/Bio-Architectural-Graph-Modeling
BAGM_DATA_ROOT=/workspace/Bio-Architectural-Graph-Modeling/data
BAGM_ARTIFACT_ROOT=/workspace/Bio-Architectural-Graph-Modeling/artifacts
BAGM_SCRATCH_ROOT=/workspace/Bio-Architectural-Graph-Modeling/scratch
BAGM_STATE_ROOT=/workspace/Bio-Architectural-Graph-Modeling/state

# Worker safety settings.
BAGM_GPU_DEVICE=0
BAGM_MIN_FREE_DISK_GB=25
BAGM_QUEUE_HEARTBEAT_SECONDS=30

# Required for production prediction finalization. Set only in untracked .env;
# use at least 16 random bytes and keep it stable for cross-run sample keys.
BAGM_SAMPLE_KEY_SALT=
