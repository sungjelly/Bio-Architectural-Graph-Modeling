*.jpeg
*.svg
*.pdf
*.html
*.ckpt
*.pt
*.pth
*.onnx
*.h5
*.h5ad
*.hdf5
*.npy
*.npz

# Track directory placeholders inside otherwise ignored trees.
!data/
!data/**/
!data/**/.gitkeep
!data/registry/
!data/registry/*.yaml
!data/registry/README.md
!results/
!results/**/
!results/**/.gitkeep
!artifacts/
