# Python caches
__pycache__/
*.py[cod]
*.pyo

# Local agent/session metadata
.agents/
.codex/
.env
.venv/
.venv-backups/
.hf_home/

# Local runtime/cache noise
.cache/
cache/
scratch/
.ipynb_checkpoints/
.DS_Store
*.tmp
*.temp

# Logs
*.log
logs/**
workflows/**/logs/**
state/**/*.log
state/logs/**
state/**/*.pid
state/**/*.lock
state/**/pids/
state/**/logs/process_records/
state/tracking/*.sqlite*
state/tracking/backups/
state/queue/
state/optimization/
state/pids/

# Shared data inputs and generated outputs
data/**
results/**
artifacts/**
workflows/**/results/**
workflows/**/outputs/**
exports/**/*.parquet
exports/**/*.npz
exports/runs/checkpoints/

# Large data tables, reports, figures, and serialized artifacts
*.csv
!experiments/campaigns/cmp_20260824_cancer_6core_relative_qkv_multiseed/selected_gradient_requests_v1.csv
*.tsv
*.xlsx
*.xls
*.parquet
*.gz
