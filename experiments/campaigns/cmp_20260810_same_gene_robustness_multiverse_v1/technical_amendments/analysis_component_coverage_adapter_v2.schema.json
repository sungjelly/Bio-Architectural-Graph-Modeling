        "contract_launch_plan_ledger_registry_unchanged": {
          "const": true
        },
        "run_bundles_and_prepared_data_unchanged": {
          "const": true
        },
        "seeds_folds_models_hyperparameters_unchanged": {
          "const": true
        },
        "component_rows_unchanged": {
          "const": true
        },
        "gates_statistics_bootstrap_and_nulls_unchanged": {
          "const": true
        },
        "same_v2_wrapper_required_for_publish_and_verify_only": {
          "const": true
        },
        "no_retraining_authorized": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "project_path": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "(^/|(^|/)\\.\\.(/|$)|\\\\)"
      }
    },
    "file_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/project_path"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "layer_file": {
      "allOf": [
        {
          "$ref": "#/$defs/file_row"
        },
        {
          "properties": {
            "role": {
              "enum": [
                "v1_amendment",
                "v1_schema",
                "v1_wrapper",
                "v1_tests"
              ]
            }
          }
        }
      ]
    },
    "recovery_source": {
      "allOf": [
        {
          "$ref": "#/$defs/file_row"
        },
        {
          "properties": {
            "role": {
              "enum": [
                "v2_amendment_schema",
                "v2_wrapper",
                "v2_tests",
                "attempt_two_stderr_evidence"
              ]
            }
          }
        }
      ]
    },
    "attempt_one": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt",
        "recovery_layer",
        "exit_code",
