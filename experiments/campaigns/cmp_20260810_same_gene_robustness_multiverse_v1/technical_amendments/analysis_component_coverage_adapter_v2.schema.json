{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bagm:same-gene-robustness:analysis-component-coverage-adapter:v2",
  "title": "Same-gene robustness layered analysis component-coverage recovery v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "amendment_id",
    "campaign_id",
    "status",
    "frozen_at",
    "scope",
    "parent_layer",
    "correction",
    "execution_contract",
    "failed_analysis_attempts",
    "recovery_sources",
    "scientific_invariants"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "amendment_id": {
      "const": "ta_cmp_20260810_same_gene_robustness_analysis_component_coverage_adapter_v2"
    },
    "campaign_id": {
      "const": "cmp_20260810_same_gene_robustness_multiverse_v1"
    },
    "status": {
      "const": "frozen_layered_analysis_technical_recovery"
    },
    "frozen_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "scope": {
      "const": "component_coverage_equality_adapter_only_no_scientific_change"
    },
    "parent_layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_commit",
        "amendment_id",
        "files"
      ],
      "properties": {
        "git_commit": {
          "const": "5508e7b1e67e04b1987ad18cb13c6fcecf87d1ff"
        },
        "amendment_id": {
          "const": "ta_cmp_20260810_same_gene_robustness_analysis_registry_config_adapter_v1"
        },
        "files": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/layer_file"
          }
        }
      }
    },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "newly_patched_symbols",
        "arm_fold_equality",
        "arm_count_equality",
        "integer_key_semantics_changed",
        "model_or_training_changed",
        "scientific_computation_changed",
        "gate_or_threshold_changed",
        "randomization_changed",
        "scientific_payload_schema_changed",
        "provenance_extended"
      ],
      "properties": {
        "kind": {
          "const": "integer_item_tuple_component_coverage_equality_adapter"
        },
        "newly_patched_symbols": {
          "const": [
            "_verify_component_coverage",
            "_source_provenance"
          ]
        },
        "arm_fold_equality": {
          "const": "tuple_sorted_integer_items"
        },
        "arm_count_equality": {
          "const": "tuple_sorted_integer_items"
        },
        "integer_key_semantics_changed": {
          "const": false
        },
        "model_or_training_changed": {
          "const": false
        },
        "scientific_computation_changed": {
          "const": false
        },
        "gate_or_threshold_changed": {
          "const": false
        },
        "randomization_changed": {
          "const": false
        },
        "scientific_payload_schema_changed": {
          "const": false
        },
        "provenance_extended": {
          "const": true
        }
      }
    },
    "execution_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_path",
        "launch_manifest_path",
        "full_plan_path",
        "registry_database_path",
        "output_path",
        "required_plan_count",
        "verify_only_supported"
      ],
      "properties": {
        "contract_path": {
          "const": "experiments/campaigns/cmp_20260810_same_gene_robustness_multiverse_v1/frozen_task_contract.yaml"
        },
        "launch_manifest_path": {
          "const": "state/materialized/same_gene_robustness_v1/recovery_r1/launch_manifest.json"
        },
        "full_plan_path": {
          "const": "state/materialized/same_gene_robustness_v1/recovery_r1/full/attempt1/plan.json"
