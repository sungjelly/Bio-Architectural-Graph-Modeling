        },
        "required_plan_count": {
          "const": 1
        },
        "verify_only_supported": {
          "const": true
        }
      }
    },
    "failed_analysis_attempts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/attempt_one"
        },
        {
          "$ref": "#/$defs/attempt_two"
        }
      ],
      "items": false
    },
    "recovery_sources": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/recovery_source"
      }
    },
    "scientific_invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v1_layer_unchanged",
        "original_48_sources_unchanged",
        "contract_launch_plan_ledger_registry_unchanged",
        "run_bundles_and_prepared_data_unchanged",
        "seeds_folds_models_hyperparameters_unchanged",
        "component_rows_unchanged",
        "gates_statistics_bootstrap_and_nulls_unchanged",
        "same_v2_wrapper_required_for_publish_and_verify_only",
