[Unit]
Description=Bio-Architectural Graph Modeling one-GPU queue worker
After=network.target

[Service]
Type=simple
WorkingDirectory=/workspace/BAGM
Environment=PYTHONPATH=/workspace/BAGM/src
Environment=BAGM_GPU_DEVICE=0
EnvironmentFile=-/workspace/BAGM/.env
ExecStartPre=/usr/bin/mkdir -p /workspace/BAGM/state/logs
ExecStart=/venv/main/bin/python -m spatial_benchmark worker
Restart=on-failure
RestartSec=15
TimeoutStopSec=90
KillSignal=SIGTERM
SendSIGKILL=no
StandardOutput=append:/workspace/BAGM/state/logs/worker.stdout.log
StandardError=append:/workspace/BAGM/state/logs/worker.stderr.log

[Install]
WantedBy=default.target
